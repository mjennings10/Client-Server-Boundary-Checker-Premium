// =============================================================================
// PRISMA SCHEMA - Client/Server Boundary Checker Premium
// =============================================================================
// This schema defines the database structure for the premium version of the
// boundary checker. We use SQLite for simplicity and Vercel compatibility.
//
// KEY DESIGN DECISIONS:
// 1. SQLite chosen for zero-config deployment and serverless compatibility
// 2. JSON fields used for flexible, evolving data structures (pipeline results, patterns)
// 3. Separate tables for analytics events to enable time-series analysis
// 4. UserConfig is a singleton pattern (single row with id="default")
//
// MIGRATION NOTES:
// - Run `npx prisma db push` for development
// - Run `npx prisma migrate dev` for production migrations
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =============================================================================
// BOUNDARY CHECK MODEL
// =============================================================================
// Stores each code analysis with full pipeline results.
// This is the primary data model for the application.
//
// PREMIUM FIELDS EXPLAINED:
// - analysisDepth: Controls how thorough the analysis is (quick/standard/comprehensive)
// - pipelineResults: JSON blob containing all 5 pipeline step outputs
// - patterns: Detected code patterns (APIs, hooks, imports found)
// - riskLevel: Calculated risk assessment (low/medium/high/critical)
// - suggestions: AI-generated refactoring recommendations
// - batchId: Groups analyses from batch operations together
// - metadata: Extensible field for future features
// =============================================================================

model BoundaryCheck {
  // Primary identifier - UUID for global uniqueness
  id              String   @id @default(uuid())

  // Timestamp for ordering and analytics
  createdAt       DateTime @default(now())

  // ==========================================================================
  // CORE FIELDS (from base version)
  // ==========================================================================

  // The original code snippet submitted for analysis
  // We store this to enable re-analysis and history viewing
  code            String

  // The final classification result: "client-only" | "server-only" | "both"
  classification  String

  // Human-readable explanation of why this classification was chosen
  // Generated by the AI during the classification step
  explanation     String

  // ==========================================================================
  // PREMIUM FIELDS
  // ==========================================================================

  // Analysis depth setting used for this check
  // Values: "quick" | "standard" | "comprehensive"
  // - quick: Basic classification only (faster, cheaper)
  // - standard: Full pipeline with moderate detail
  // - comprehensive: Maximum detail, examples, and suggestions
  analysisDepth   String   @default("standard")

  // JSON blob containing all pipeline step results
  // Structure: { step1: {...}, step2: {...}, ... step5: {...} }
  // Each step contains: status, data, timing, errors
  pipelineResults String?

  // Detected patterns as JSON array
  // Structure: [{ type: "api"|"hook"|"import", name: string, line: number }]
  // Used for pattern analytics and visualization
  patterns        String?

  // Risk assessment level for boundary violations
  // Values: "low" | "medium" | "high" | "critical"
  // - low: Code is safe in its intended environment
  // - medium: Minor issues, could work with small changes
  // - high: Significant boundary violations detected
  // - critical: Code will definitely fail in wrong environment
  riskLevel       String?

  // AI-generated refactoring suggestions as JSON array
  // Structure: [{ issue: string, suggestion: string, priority: number }]
  suggestions     String?

  // Batch operation identifier for grouping related analyses
  // NULL for single analyses, UUID for batch operations
  batchId         String?

  // Extensible metadata field for future features
  // Can store: framework version, user preferences at time of analysis, etc.
  metadata        String?

  // Index for faster history queries (most recent first)
  @@index([createdAt(sort: Desc)])

  // Index for batch lookups
  @@index([batchId])
}

// =============================================================================
// ANALYTICS EVENT MODEL
// =============================================================================
// Tracks events for the analytics dashboard.
// Designed for time-series analysis and pattern detection.
//
// EVENT TYPES:
// - "analysis": A code analysis was performed
// - "batch_start": A batch analysis began
// - "batch_complete": A batch analysis finished
// - "config_change": User changed settings
// - "export": User exported results
//
// This enables features like:
// - Usage charts over time
// - Popular pattern detection
// - Performance monitoring
// =============================================================================

model AnalyticsEvent {
  // Primary identifier
  id          String   @id @default(uuid())

  // Event timestamp for time-series queries
  createdAt   DateTime @default(now())

  // Event type for filtering and categorization
  eventType   String

  // Flexible JSON data payload
  // Structure varies by eventType
  data        String

  // Index for efficient time-range queries
  @@index([createdAt(sort: Desc)])

  // Index for event type filtering
  @@index([eventType])
}

// =============================================================================
// USER CONFIG MODEL
// =============================================================================
// Singleton pattern for storing user preferences.
// Only one row should exist with id="default".
//
// WHY A SINGLETON?
// - No authentication in this version, so single user assumed
// - Simple to query and update
// - Easy to extend with new preferences
// - Can be converted to per-user config if auth is added later
//
// PREFERENCES EXPLAINED:
// - analysisDepth: Default depth for new analyses
// - frameworkMode: Target framework (app-router, pages-router)
// - strictnessLevel: How strict the boundary checking should be
// =============================================================================

model UserConfig {
  // Singleton ID - always "default" for this application
  id              String   @id @default("default")

  // Default analysis depth for new analyses
  // Values: "quick" | "standard" | "comprehensive"
  analysisDepth   String   @default("standard")

  // Target Next.js framework mode
  // Values: "app-router" | "pages-router"
  // Different rules apply to each mode
  frameworkMode   String   @default("app-router")

  // Boundary checking strictness
  // Values: "lenient" | "standard" | "strict"
  // - lenient: Only flag definite violations
  // - standard: Flag violations and warnings
  // - strict: Flag any potential issues
  strictnessLevel String   @default("standard")

  // Track when config was last modified
  updatedAt       DateTime @updatedAt
}
